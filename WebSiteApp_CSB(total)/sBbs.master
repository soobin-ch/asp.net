<%@ Master Language="C#" MasterPageFile="~/MainMaster.master" AutoEventWireup="true" CodeFile="sBbs.master.cs" Inherits="sBbs" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" Runat="Server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" Runat="Server">
    <table style="width:900px; border-collapse:collapse; " border="0">
        <tr>
            <td style="width:170px; text-align:center; vertical-align:top;">
                <asp:Image ID="Image2" runat="server" ImageUrl="~/images/sMaster.jpg" Width="170px" />
                <strong>
                    C#, ASP.NET 및 MS-SQL에 <br /> 관심있는 사람들을 환영합니다.
                </strong>
                <asp:ImageButton ID="ibtnFree" runat="server" ImageUrl="~/images/sFree.jpg" Width="140px" OnClick="ibtnFree_Click" CausesValidation="False" /><br />
                <asp:ImageButton ID="ibtnQnA" runat="server" ImageUrl="~/images/sQnA.jpg"  Width="140px" OnClick="ibtnQnA_Click" CausesValidation="False" /><br />
                <asp:ImageButton ID="ibtnPoll" runat="server" ImageUrl="~/images/sPoll.jpg" Width="140px" OnClick="ibtnPoll_Click" CausesValidation="False" />
                <asp:ImageButton ID="ibtnMessage" runat="server" ImageUrl="~/images/sMessage.jpg" Width="140px" OnClick="ibtnMessage_Click" CausesValidation="False" />
            </td>
            <td style="width:730px; text-align:center; vertical-align:top;" >
               <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
        
                </asp:ContentPlaceHolder>
            </td>
        </tr>
    </table>
</asp:Content>

